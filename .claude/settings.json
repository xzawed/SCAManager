{
  "permissions": {
    "deny": [
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(!**/.env.sample)",
      "Read(!**/.env.template)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.prod*)",
      "Read(//**/.env.dev*)",
      "Read(//**/.env.stag*)",
      "Read(//**/.env.test*)",
      "Read(//**/.env-*)",
      "Read(//**/.env_*)",
      "Read(//**/*.env *)",
      "Read(//**/.env.* *)",
      "Read(//**/.env*.sw?)",
      "Read(//**/.env.*~)",
      "Read(//**/*.env)",
      "Read(//**/*.env~)",
      "Read(//**/env[._-]backup*)",
      "Read(//**/*[._-]env[._-]backup*)",
      "Read(//**/env[._-]bak*)",
      "Read(//**/*[._-]env[._-]bak*)",
      "Read(//**/env[._-]old*)",
      "Read(//**/*[._-]env[._-]old*)",
      "Read(//**/env[._-]orig*)",
      "Read(//**/*[._-]env[._-]orig*)",
      "Read(//**/env[._-]save*)",
      "Read(//**/*[._-]env[._-]save*)",
      "Read(//**/env[._-]copy*)",
      "Read(//**/*[._-]env[._-]copy*)",
      "mcp__plugin_grok_grok-build__grok_build_delegate",
      "mcp__plugin_grok_grok-build__grok_build_verify",
      "mcp__plugin_grok_grok-build__grok_cli"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v py >/dev/null 2>&1 && echo 'py -3' || echo python3); $PY ${CLAUDE_PROJECT_DIR:-.}/scripts/check_main_red.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "PY=$(command -v py >/dev/null 2>&1 && echo 'py -3' || echo python3); $PY ${CLAUDE_PROJECT_DIR:-.}/scripts/check_precommit_installed.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "PY=$(command -v py >/dev/null 2>&1 && echo 'py -3' || echo python3); $PY ${CLAUDE_PROJECT_DIR:-.}/scripts/prune_agent_worktrees.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "PY=$(command -v py >/dev/null 2>&1 && echo 'py -3' || echo python3); $PY ${CLAUDE_PROJECT_DIR:-.}/scripts/check_memory_refs.py --advisory",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v py >/dev/null 2>&1 && echo 'py -3' || echo python3); $PY ${CLAUDE_PROJECT_DIR:-.}/scripts/check_hook_surface_fresh.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "PY=$(command -v py >/dev/null 2>&1 && echo 'py -3' || echo python3); $PY ${CLAUDE_PROJECT_DIR:-.}/scripts/retro_scope.py --signal",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*[Rr]ailway.*|mcp__.*[Ss]upabase.*",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v py >/dev/null 2>&1 && echo 'py -3' || echo python3); $PY ${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block_credential_dump.py",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "PY=$(command -v py >/dev/null 2>&1 && echo 'py -3' || echo python3); $PY ${CLAUDE_PROJECT_DIR:-.}/scripts/scan_publish.py --hook",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "PowerShell(gh *)",
            "command": "PY=$(command -v py >/dev/null 2>&1 && echo 'py -3' || echo python3); $PY ${CLAUDE_PROJECT_DIR:-.}/scripts/scan_publish.py --hook",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v py >/dev/null 2>&1 && echo 'py -3' || echo python3); $PY ${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check_edit_allowed.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v py >/dev/null 2>&1 && echo 'py -3' || echo python3); $PY ${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/posttool_pytest_smoke.py",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "PY=$(command -v py >/dev/null 2>&1 && echo 'py -3' || echo python3); $PY ${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check_memory_after_write.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v py >/dev/null 2>&1 && echo 'py -3' || echo python3); $PY ${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/detect_protected_bash_write.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
